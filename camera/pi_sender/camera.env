# FogSen sends camera video to the laptop over Wi-Fi TCP only.
FOGSEN_CAMERA_BIND_HOST=0.0.0.0
FOGSEN_CAMERA_PORT=8888
FOGSEN_CAMERA_WIDTH=1296
FOGSEN_CAMERA_HEIGHT=972
FOGSEN_CAMERA_FPS=30
FOGSEN_CAMERA_BITRATE=8000000

# The Pi Zero W sustains 30 FPS with the costly colour denoise stage disabled.
FOGSEN_CAMERA_DENOISE=cdn_off
FOGSEN_CAMERA_RESTART_MIN_SECONDS=1
FOGSEN_CAMERA_RESTART_MAX_SECONDS=30
FOGSEN_CAMERA_STABLE_RUN_SECONDS=30
