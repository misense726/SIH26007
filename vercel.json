{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci && python -m pip install 'numpy>=2,<3' 'pydantic>=2.10,<3' 'PyYAML>=6,<7' 'shapely>=2.1,<3'",
  "buildCommand": "python -m scripts.export_demo && npm --prefix frontend run build:demo",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/textures/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/demo/:chunk.json.gz",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/gzip" }
      ]
    },
    {
      "source": "/demo/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/demo/sensor-settings.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
