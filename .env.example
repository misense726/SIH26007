FOGSEN_HOST=127.0.0.1
FOGSEN_PORT=8000
FOGSEN_CONFIG_DIR=config
FOGSEN_TELEMETRY_HZ=10

# Raspberry Pi camera over Wi-Fi. This is not a USB video or USB-LAN path.
FOGSEN_CAMERA_STREAM_URL=tcp://10.38.143.254:8888
FOGSEN_CAMERA_STALE_MS=1500
FOGSEN_CAMERA_RECONNECT_MS=1000
FOGSEN_CAMERA_OPEN_TIMEOUT_MS=15000
FOGSEN_CAMERA_READ_TIMEOUT_MS=5000
FOGSEN_CAMERA_JPEG_QUALITY=88
FOGSEN_CAMERA_METRICS_INTERVAL_MS=500
FOGSEN_CAMERA_DEHAZE_ENABLED=true
FOGSEN_CAMERA_DEHAZE_DEVICE=cuda
FOGSEN_CAMERA_DEHAZE_FP16=true
FOGSEN_CAMERA_DEHAZE_MAX_FPS=30

# Infrared (IR) video enhancement.
FOGSEN_CAMERA_IR_ENABLED=true
FOGSEN_CAMERA_IR_DEVICE=cuda
FOGSEN_CAMERA_IR_FP16=true
FOGSEN_CAMERA_IR_MAX_FPS=30
FOGSEN_CAMERA_IR_COLORMAP=INFERNO

# MAIN telemetry. WIFI keeps COM11 free for upload and USB diagnostics.
FOGSEN_TELEMETRY_TRANSPORT=SERIAL
FOGSEN_WIFI_LISTEN_HOST=0.0.0.0
FOGSEN_WIFI_LISTEN_PORT=8765
